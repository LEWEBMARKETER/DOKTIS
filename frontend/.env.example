NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Adresse de l'API vue depuis le serveur Next.js (facultatif, sinon NEXT_PUBLIC_API_URL).
# API_URL=http://backend:8000/api
# Adresse publique du site, utilisée pour le sitemap, les liens canoniques et llms.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Modules de l'espace praticien (doivent refléter DOKTA_MODULE_* côté API). V1 : annuaire seul.
NEXT_PUBLIC_DOKTA_MODULE_SAAS=false
NEXT_PUBLIC_DOKTA_MODULE_PATIENT=false
