# Adresse de l'API vue par le navigateur. En production : /api (relayé par Next.js vers l'API).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Origine de l'API vue par le serveur Next.js, cible du relais /api (défaut : http://localhost:8000).
# Sur Render, API_HOSTPORT (adresse privée « doktis-api:10000 ») est fourni par render.yaml.
# API_ORIGIN=http://localhost:8000
# Adresse publique du site (sitemap, liens canoniques, QR codes). Sur Render, RENDER_EXTERNAL_URL
# est utilisée tant que cette variable n'est pas définie.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Modules de l'espace praticien (doivent refléter DOKTA_MODULE_* côté API). V1 : annuaire seul.
NEXT_PUBLIC_DOKTA_MODULE_SAAS=false
NEXT_PUBLIC_DOKTA_MODULE_PATIENT=false
